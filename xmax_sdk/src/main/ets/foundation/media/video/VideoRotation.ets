/** A clockwise video frame rotation. */
export enum VideoRotation {

  /** A clockwise rotation of 0 degrees. */
  ROTATION_0 = 0,

  /** A clockwise rotation of 90 degrees. */
  ROTATION_90 = 90,

  /** A clockwise rotation of 180 degrees. */
  ROTATION_180 = 180,

  /** A clockwise rotation of 270 degrees. */
  ROTATION_270 = 270
}
